import java.util.ArrayList;
import java.util.List;
public class Main {
    public static void main(String[] args) {
        List<Product> products = new ArrayList<>();
        products.add(new Product("893001", "Coca Cola", 10000));
        products.add(new Product("893002", "Pepsi", 10000));
        products.add(new Product("893003", "Sting", 12000));
        products.add(new Product("893004", "Nước suối", 5000));
        ProductCache cache = new ProductCache();
        cache.loadData(products);
        System.out.println("Tìm sản phẩm 893002:");
        Product product1 = cache.findByBarcode("893002");
        if (product1 != null) {
            System.out.println(product1);
        }
        System.out.println();
        System.out.println("Tìm sản phẩm 999999:");
        Product product2 = cache.findByBarcode("999999");
        if (product2 != null) {
            System.out.println(product2);
        }
    }
}
